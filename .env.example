# Activity Lens *runtime* configuration — copy to `.env` and adjust.
#
# Everything here is read by the running server. docker compose loads this file
# automatically for ${VAR} substitution in docker-compose.yml, and the backend
# reads the same AL_* variables straight from its environment, so it works for
# both compose and a bare run.
#
# Anything needed only to *build* the app — the version stamp and the Android
# signing key — lives in `.env.build.example` instead. Nothing in that file
# affects a running server, and nothing in this one affects a build.

# --- Server ----------------------------------------------------------------
# Listen address inside the container.
AL_ADDR=:8080
# Directory for the SQLite database and uploaded files (a volume in compose).
AL_DATA_DIR=/data
# Optional: override the database DSN (kept for a future Postgres migration).
# When empty, a SQLite file under AL_DATA_DIR is used.
# AL_DATABASE_URL=

# --- Bootstrap admin -------------------------------------------------------
# Created on first run if it does not already exist. The password must contain
# both letters and numbers. CHANGE THESE before deploying.
AL_ADMIN_USER=admin
AL_ADMIN_EMAIL=admin@example.com
AL_ADMIN_PASS=changeme123

# --- Sessions & cookies ----------------------------------------------------
# Session lifetime (Go duration, e.g. 720h = 30 days).
AL_SESSION_TTL=720h
# Session cookie name.
AL_COOKIE_NAME=al_session
# Force the Secure cookie flag. Set to true when served over HTTPS (e.g. behind
# a TLS-terminating reverse proxy).
AL_SECURE_COOKIES=false

# --- Registration ----------------------------------------------------------
# Allow self-service account registration with a password.
AL_ALLOW_REGISTRATION=false

# --- OIDC / SSO (optional) -------------------------------------------------
# Set AL_OIDC_ENABLED=true and fill in the issuer, client and redirect to
# enable single sign-on.
AL_OIDC_ENABLED=false
# AL_OIDC_ISSUER_URL=https://id.example.com
# AL_OIDC_CLIENT_ID=
# AL_OIDC_CLIENT_SECRET=
# AL_OIDC_REDIRECT_URL=https://activity-lens.example.com/api/auth/oidc/callback
# AL_OIDC_ADMIN_GROUP=
# AL_OIDC_PROVIDER_NAME=SSO
# Logo on the SSO button. LOGO_URL is used in both themes; set LOGO_URL_DARK
# only when the main logo is dark ink that disappears on the dark login card.
# AL_OIDC_LOGO_URL=https://example.com/logo.svg
# AL_OIDC_LOGO_URL_DARK=https://example.com/logo-light.svg
# AL_OIDC_ALLOW_REGISTRATION=true
# Comma-separated extra scopes.
# AL_OIDC_SCOPES=

# ── SMTP (transactional email, e.g. account-deletion codes) ──
# AL_SMTP_HOST=smtp.example.com
# AL_SMTP_PORT=587
# AL_SMTP_USERNAME=
# AL_SMTP_PASSWORD=
# AL_SMTP_FROM=no-reply@example.com
# AL_SMTP_FROM_NAME=Activity Lens
# Encryption: starttls (default, port 587), tls (implicit/SSL, port 465), or none.
# AL_SMTP_ENCRYPTION=starttls

# push notifications (optional)
AL_PUSH_SUBJECT=mailto:admin@localhost

# Offer the bundled Android app: a download link on the login page, and
# the in-app update check. Set to false for a build that should not.
AL_ANDROID_APP=true
