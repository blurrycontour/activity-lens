node_modules/

# The collected APK and its metadata, written by scripts/apk.sh and copied into
# the server image. Build output, never committed.
dist/*
!dist/.gitkeep

# Gradle writes three more build directories under android/, all covered by
# android/.gitignore: android/.gradle (its own caches), android/build (the root
# project) and android/app/build (the module that actually produces the APK).
# capacitor-cordova-android-plugins/ is regenerated by `cap sync` and is ignored
# there too.

# Signing material. A keystore in the repo is a keystore anyone can sign as you.
*.keystore
*.jks
keystore.properties
