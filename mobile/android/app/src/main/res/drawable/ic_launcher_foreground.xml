<?xml version="1.0" encoding="utf-8"?>
<!--
  The Activity Lens mark, as an Android vector.

  Hand-written, and kept in step with frontend/public/logo.svg — the same two
  shapes, the same numbers. The one difference is the ring: logo.svg draws it as
  a full circle with a stroke-dasharray, which Android has no equivalent for, so
  the same three-quarter arc is written out as an explicit arc command. The two
  render identically (verified by rasterising both and diffing).

  A vector rather than the density-bucketed PNGs Capacitor generates: it is one
  file instead of ten, it is sharp at any size including whatever the launcher
  invents, and it cannot drift out of sync with the web icons the way a folder of
  committed pixels does.

  108dp with the mark at 0.55 is the adaptive-icon contract: only the central
  72dp is guaranteed visible, and the launcher masks and animates the rest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.55"
        android:scaleY="0.55">

        <!-- The open ring: 270 degrees, gap at the bottom. -->
        <path
            android:pathData="M 121.65,390.35 A 190,190 0 1 1 390.35,390.35"
            android:strokeColor="#00e87a"
            android:strokeWidth="40"
            android:strokeLineCap="round" />

        <!-- The trace across it. -->
        <path
            android:pathData="M 380,256 H 319 L 287,360 L 224,151 L 193,256 H 130"
            android:strokeColor="#00e87a"
            android:strokeWidth="32"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
