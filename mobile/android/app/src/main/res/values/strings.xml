<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- app_name is not here: build.gradle sets it per build type, so a local
         debug build is "Activity Lens Dev" and can sit beside the real one. -->
    <string name="title_activity_main">Activity Lens</string>
    <string name="package_name">io.blurrycontour.activitylens</string>
    <string name="custom_url_scheme">io.blurrycontour.activitylens</string>
    <!-- Shown in Android's per-app notification settings. -->
    <string name="notification_channel_name">Activity Lens</string>
    <string name="notification_channel_description">Shared workouts, gear wear and training goals.</string>
    <string name="session_channel_name">Training session</string>
    <string name="session_channel_description">A quiet, ongoing note while a training session is running.</string>
    <!-- The two ways a session ends, offered as notification actions. Both
         open the app on the session; see SessionNoticePlugin. -->
    <string name="session_action_finish">Finish</string>
    <string name="session_action_discard">Discard</string>
</resources>
