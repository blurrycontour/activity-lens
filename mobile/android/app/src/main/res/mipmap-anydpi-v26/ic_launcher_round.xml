<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so this is the only launcher icon definition the app needs and
  there are no legacy PNG variants to keep in sync with it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the launcher recolours this to the user's
         wallpaper palette. Without it the app is one of the icons that stays
         stubbornly coloured when everything else adapts. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
