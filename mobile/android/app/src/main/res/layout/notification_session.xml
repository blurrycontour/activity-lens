<?xml version="1.0" encoding="utf-8"?>
<!--
  The body of the ongoing session notification.

  A custom view for one reason: the elapsed time has to sit with the rest of
  the numbers rather than in the header. Android's standard template can draw a
  running clock only in the header line, beside the app's name, which is the
  one place it reads as the time of day rather than as how long you have been
  training. A Chronometer here counts on its own, with nothing re-posted for
  it — the same free tick, in the right place.

  Wrapped by DecoratedCustomViewStyle, so the header, the icons and the action
  buttons are still the system's own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/notice_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:paddingTop="1dp">

        <Chronometer
            android:id="@+id/notice_clock"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6dp"
            android:paddingRight="6dp" />

        <TextView
            android:id="@+id/notice_body"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- What comes next. Only the expanded view sets this visible: collapsed
         has two lines and they are both spoken for. -->
    <TextView
        android:id="@+id/notice_next"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
