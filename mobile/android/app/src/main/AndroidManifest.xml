<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      HAND-EDITED. Capacitor generated this file and will not overwrite it, but a
      future `cap` upgrade may ship a different template — see mobile/README.md,
      which lists every change made here so they can be re-applied deliberately.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where the browser returns a finished SSO sign-in.

                 The scheme is ${applicationId}, so a local build (which carries
                 an id suffix so it installs alongside the published app) gets a
                 distinct one automatically. Without that, both copies would
                 claim the same link and Android would ask the user which app it
                 meant every time.

                 What arrives here is a single-use code, not a session: any app
                 may register a custom scheme, so the deep link is assumed to be
                 readable by others and carries nothing usable on its own. See
                 backend/internal/httpapi/oidc_native.go. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="auth" />
            </intent-filter>

            <!-- The share sheet: another app sending a workout file here.
                 This is what `share_target` in the web manifest does for the
                 PWA, which Android does not honour for an installed web app —
                 so without it the APK is the one install where sharing a
                 workout offers everything except Activity Lens.

                 The type list mirrors the web manifest's. It is deliberately
                 wide: exporters routinely share a .gpx as octet-stream, or as
                 nothing at all, and a filter that only accepted the correct
                 types would miss most of them. IncomingFiles then drops
                 anything whose name is not a workout file, so the cost of
                 being offered a file we cannot use is a message, not an
                 import.

                 Two things about this list are not obvious and are worth
                 writing down, because they decide whether the app appears in
                 one file manager's share sheet and not another's:

                 An intent whose own type is `*/*` matches any filter that
                 declares at least one type — IntentFilter.findMimeType says so
                 explicitly — so the "shared as anything" case needs nothing
                 here. `application/*` likewise matches every `application/…`
                 below.

                 The aliases do need declaring. `.zip` and `.gz` have one
                 registered type each and several in circulation, and a manager
                 that hands out `application/x-gzip` matches nothing above no
                 matter how close it is. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- The same share, from an app that set no type at all.
                 A filter that declares a type cannot match an intent without
                 one, so this genuinely needs to be its own filter — and it can
                 only ever match a typeless share, which is why it is safe to
                 leave open. Sharing text or a photo always carries a type, so
                 this does not put Activity Lens in those share sheets. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- "Open with" on a workout file, the native equivalent of the web
                 manifest's `file_handlers`.

                 Types first, which covers the archives: `.zip` and `.gz` are in
                 Android's MimeTypeMap, so a file manager opening one really does
                 send application/zip or application/gzip. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
            </intent-filter>

            <!-- `.gpx`, `.tcx` and `.fit`, which the filter above cannot catch.
                 None of the three is in Android's MimeTypeMap, so nothing ever
                 sends application/gpx+xml: a file manager asks the platform for
                 the type, gets null, and falls back to application/octet-stream
                 or */*. Matching on the *name* is the only thing that works,
                 and `mimeType="*/*"` is required to get there — a filter with a
                 path but no type only matches an intent carrying no type at all,
                 which is why this did nothing when it was first added.

                 `host="*"` is equally load-bearing: Android ignores path
                 attributes entirely unless a scheme and a host are both given.

                 The repeated patterns are the ugly part, and they are not
                 redundant. `pathPattern` is PATTERN_SIMPLE_GLOB, whose `.*`
                 scans to the *first* occurrence of the character after it and
                 never backtracks — so `.*\\.gpx` stops at the first dot and
                 fails on `2024-03-01.morning.gpx`. One extra `.*\\.` per dot
                 the name might contain is the standard workaround. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.tcx" />
                <data android:pathPattern=".*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fit" />
            </intent-filter>

            <!-- The same names again, for an intent that carries no type at all.
                 A filter that declares a mimeType cannot match one that does not,
                 so the two cases genuinely need separate filters. Mostly this is
                 `file://` URIs from older apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.tcx" />
                <data android:pathPattern=".*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fit" />
            </intent-filter>

        </activity>

        <!-- Receives push from a UnifiedPush distributor (ntfy and friends).
             Exported because the distributor is a different app and has to be
             able to reach it; the receiver itself checks that the token on every
             broadcast is the one we registered with. -->
        <receiver
            android:name=".UnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app install an APK it downloaded, for the in-app updater.
         Not a silent grant: the user must additionally allow "install
         unknown apps" for this app, and the system still shows its own
         confirmation dialog for every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required from Android 13 to show a notification at all. Requested at the
         moment the user enables push, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Settings offer the "always allow in the background" prompt for
         auto-import directly, instead of sending the user to find this app in a
         list of every app on the phone. Only declared so the system dialog can
         be shown; the exemption is entirely the user's to grant or refuse, and
         auto-import works either way — just later. Play restricts apps that ask
         for this without cause; the app is distributed as an APK, and the cause
         is a background import the OS otherwise defers indefinitely. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Saving an export to the Downloads folder, on Android 9 and older only.
         From Android 10 MediaStore does this with no permission, and the cap
         means newer phones never see the request. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11 and later hide installed packages from an app unless it says
         what it is looking for. Without this, querying for distributors returns
         nothing and push looks unavailable on every modern phone. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>
</manifest>
