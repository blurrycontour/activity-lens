<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      HAND-EDITED. Capacitor generated this file and will not overwrite it, but a
      future `cap` upgrade may ship a different template — see mobile/README.md,
      which lists every change made here so they can be re-applied deliberately.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where the browser returns a finished SSO sign-in.

                 The scheme is ${applicationId}, so a local build (which carries
                 an id suffix so it installs alongside the published app) gets a
                 distinct one automatically. Without that, both copies would
                 claim the same link and Android would ask the user which app it
                 meant every time.

                 What arrives here is a single-use code, not a session: any app
                 may register a custom scheme, so the deep link is assumed to be
                 readable by others and carries nothing usable on its own. See
                 backend/internal/httpapi/oidc_native.go. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="auth" />
            </intent-filter>

            <!-- The share sheet: another app sending a workout file here.
                 This is what `share_target` in the web manifest does for the
                 PWA, which Android does not honour for an installed web app —
                 so without it the APK is the one install where sharing a
                 workout offers everything except Activity Lens.

                 The type list mirrors the web manifest's. It is deliberately
                 wide: exporters routinely share a .gpx as octet-stream, or as
                 nothing at all, and a filter that only accepted the correct
                 types would miss most of them. IncomingFiles then drops
                 anything whose name is not a workout file, so the cost of
                 being offered a file we cannot use is a message, not an
                 import. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- "Open with" on a workout file in a file manager, the native
                 equivalent of the manifest's `file_handlers`.

                 Matched on type, which is what a `content://` URI from a
                 document provider carries; its path is the provider's own
                 business and says nothing about the file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/gzip" />
            </intent-filter>

            <!-- The same thing for a `file://` URI, where there is a real path
                 to match and the type is usually missing or wrong.

                 One `pathPattern` per extension because Android's globbing has
                 no alternation, and `.*\\.gpx` is greedy in a way that already
                 covers a name with dots in it — `2024.03.01-run.gpx` matches. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\.tcx" />
                <data android:pathPattern=".*\\.gpx\\.gz" />
                <data android:pathPattern=".*\\.tcx\\.gz" />
            </intent-filter>

        </activity>

        <!-- Receives push from a UnifiedPush distributor (ntfy and friends).
             Exported because the distributor is a different app and has to be
             able to reach it; the receiver itself checks that the token on every
             broadcast is the one we registered with. -->
        <receiver
            android:name=".UnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app install an APK it downloaded, for the in-app updater.
         Not a silent grant: the user must additionally allow "install
         unknown apps" for this app, and the system still shows its own
         confirmation dialog for every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required from Android 13 to show a notification at all. Requested at the
         moment the user enables push, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Saving an export to the Downloads folder, on Android 9 and older only.
         From Android 10 MediaStore does this with no permission, and the cap
         means newer phones never see the request. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11 and later hide installed packages from an app unless it says
         what it is looking for. Without this, querying for distributors returns
         nothing and push looks unavailable on every modern phone. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>
</manifest>
