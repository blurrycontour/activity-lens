# Build context is this directory (activity-lens). Keep the image small and the
# build reproducible. go-authkit is fetched from the Go module proxy, so it does
# not need to be in the context.
.git
.github
.gitignore
.dockerignore

# Local env and secrets
.env
.env.*
!.env.example

# Go: local dev workspace and build/test artifacts (deps come from the proxy)
**/go.work
**/go.work.sum
*.test
*.out
coverage.*

# Node / frontend build artifacts (rebuilt inside the image)
**/node_modules
frontend/dist
frontend/.vite

# Backend embedded assets (regenerated during the build)
backend/internal/web/dist

# Capacitor project. Only mobile/dist (the built APK, bundled into the image) is
# needed here — the Android project and its Gradle output are megabytes that the
# server image build never reads.
mobile/android
mobile/node_modules
mobile/scripts

# Runtime data and databases
.data
data
*.db
*.db-shm
*.db-wal
*.log

# Docs (not needed in the image)
README.md
LICENSE
